rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones helpers ----------
    function firmado() {
      return request.auth != null;
    }

    function esAdmin() {
      return firmado() && (
        request.auth.token.email == 'admin@viajes.com' ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'Admin')
      );
    }

    function esDuenio(uid) {
      return firmado() && request.auth.uid == uid;
    }

    function esPendiente() {
      return resource.data.status == 'pendiente';
    }

    // ---------- Colecciones ----------

    // Perfiles: cada usuario ve/si mismo; el admin ve todos.
    match /usuarios/{uid} {
      allow read: if firmado() && (esDuenio(uid) || esAdmin());
      allow create, update: if firmado() && (esDuenio(uid) || esAdmin());
      allow delete: if esAdmin();
    }

    // Catálogo: cualquiera con sesión puede leer; solo admin escribe.
    match /productos/{id} {
      allow read: if firmado();
      allow create, update, delete: if esAdmin();
    }

    // Carrito: documento por usuario (carritos/{uid}).
    match /carritos/{uid} {
      allow read, write: if esDuenio(uid);
    }

    // Pedidos: dueño o admin. El cliente solo puede modificar/borrar
    // sus pedidos mientras estén 'pendiente'.
    match /pedidos/{id} {
      allow read: if firmado() &&
                     (resource.data.usuarioId == request.auth.uid || esAdmin());

      allow create: if firmado() &&
                       (request.resource.data.usuarioId == request.auth.uid || esAdmin());

      allow update: if esAdmin() || (
        firmado() &&
        resource.data.usuarioId == request.auth.uid &&
        esPendiente() &&
        request.resource.data.status == 'pendiente'
      );

      allow delete: if firmado() &&
                       resource.data.usuarioId == request.auth.uid &&
                       esPendiente();
    }
  }
}
